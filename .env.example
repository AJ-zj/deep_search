# ===== LLM（必填）=====
# 任意 OpenAI 兼容接口均可（硅基流动 / DeepSeek / OpenAI / Ollama...）
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
OPENAI_API_KEY=sk-你的密钥
LLM_MODEL=Qwen/Qwen2.5-32B-Instruct

# ===== 搜索（强烈建议填）=====
# 不填也能跑，但会降级到内置离线资料
# 注册：https://tavily.com  免费额度约 1000 次/月
TAVILY_API_KEY=tvly-你的密钥

# ===== 地图与天气（仅旅行领域需要）=====
# 高德开放平台：https://console.amap.com/  用「Web服务」类型的 Key
AMAP_API_KEY=

# ===== 图片（可选）=====
# https://unsplash.com/developers  免费 50 次/小时；用完自动降级为示意图
UNSPLASH_ACCESS_KEY=

# ===== 服务 =====
HOST=127.0.0.1
PORT=8003
